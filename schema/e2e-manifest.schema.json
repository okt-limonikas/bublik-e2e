{
  "$defs": {
    "Bundle": {
      "additionalProperties": false,
      "description": "One generated+published fixture run and everything derived from it.",
      "properties": {
        "conclusionSpec": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "e2eRunId": {
          "type": "string"
        },
        "expectedRuns": {
          "items": {
            "$ref": "#/$defs/ExpectedRun"
          },
          "type": "array"
        },
        "finishTimestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fixture": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "importUrl": {
          "type": "string"
        },
        "logUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logUrlTemplate": {
          "type": "string"
        },
        "mix": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "revisions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Revision"
          },
          "type": "array"
        },
        "runId": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runStatus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runUrlTemplate": {
          "type": "string"
        },
        "startTimestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "id",
        "fixture",
        "conclusionSpec",
        "mix",
        "date",
        "importUrl",
        "project",
        "e2eRunId",
        "runUrlTemplate",
        "logUrlTemplate",
        "expectedRuns"
      ],
      "type": "object"
    },
    "ExpectedRun": {
      "additionalProperties": false,
      "description": "The expectations + samples the UI asserts against for one imported run.",
      "properties": {
        "dashboardDate": {
          "type": "string"
        },
        "expectedConclusion": {
          "type": "string"
        },
        "expectedConclusionReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expectedMatrix": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "expectedStatus": {
          "type": "string"
        },
        "expectedStatusByNok": {
          "type": "string"
        },
        "iterationCount": {
          "type": "integer"
        },
        "logUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MeasurementSummary"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "packages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PackageSummary"
          },
          "type": "array"
        },
        "requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sampleTests": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/IterationEntry"
            },
            "type": "array"
          },
          "default": {},
          "type": "object"
        },
        "tags": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "verdicts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "dashboardDate",
        "iterationCount",
        "expectedStatus",
        "expectedStatusByNok",
        "expectedConclusion",
        "expectedMatrix"
      ],
      "type": "object"
    },
    "IterationEntry": {
      "additionalProperties": false,
      "description": "A sampled leaf iteration shown in the UI (see ``sampleTests``).\n\n``params``/``verdicts``/``artifacts``/``measurements`` carry the raw,\nprovider-shaped payloads and are intentionally left loose.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {},
          "type": "array"
        },
        "expectedStatus": {
          "type": "string"
        },
        "measurements": {
          "default": [],
          "items": {},
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pathStr": {
          "default": "",
          "type": "string"
        },
        "reqs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "tin": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unexpected": {
          "type": "boolean"
        },
        "verdicts": {
          "default": [],
          "items": {},
          "type": "array"
        }
      },
      "required": [
        "status",
        "expectedStatus",
        "unexpected"
      ],
      "type": "object"
    },
    "MeasurementSummary": {
      "additionalProperties": false,
      "description": "One flattened measurement entry across all leaf iterations.",
      "properties": {
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "testPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "PackageSummary": {
      "additionalProperties": false,
      "description": "Per top-level package status rollup.",
      "properties": {
        "byStatus": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "total",
        "byStatus"
      ],
      "type": "object"
    },
    "ReportConfig": {
      "additionalProperties": false,
      "description": "A UI report config bundled into the manifest. ``content`` is free-form.",
      "properties": {
        "content": {
          "additionalProperties": true,
          "type": "object"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "type": {
          "const": "report",
          "type": "string"
        }
      },
      "required": [
        "project",
        "type",
        "name",
        "content"
      ],
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "description": "A single source revision parsed from run metas (``*_GIT_URL`` etc.).",
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "rev": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level e2e manifest written to ``.e2e/e2e-manifest.json``.",
  "properties": {
    "baseUrl": {
      "type": "string"
    },
    "bundles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Bundle"
      },
      "type": "array"
    },
    "configs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReportConfig"
      },
      "type": "array"
    },
    "dashboardUrl": {
      "type": "string"
    },
    "emptyDates": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generatedAt": {
      "type": "string"
    },
    "historyUrl": {
      "type": "string"
    },
    "importUrl": {
      "type": "string"
    },
    "uiBaseUrl": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "generatedAt",
    "baseUrl",
    "uiBaseUrl",
    "dashboardUrl",
    "historyUrl",
    "importUrl"
  ],
  "type": "object"
}
